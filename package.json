{
  "name": "athena-exam-proctoring",
  "private": true,
  "version": "1.0.0",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --mac dmg",
    "pack": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
  "appId": "com.athena.examproctoring",
  "productName": "Athena Exam Proctoring",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "mac": {
    "target": "dmg",
    "category": "public.app-category.education",
    "identity": null
  }
},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
